[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.08, 0.08, 0.12, 1)

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="BG" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_styles/panel = SubResource("StyleBoxFlat_bg")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 15
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 15

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TopBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 24
text = "角色选择"

[node name="Spacer" type="Control" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="GoldLabel" type="Label" parent="MarginContainer/VBox/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 18
text = "💰 0"

[node name="DiamondLabel" type="Label" parent="MarginContainer/VBox/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.7, 1.0, 1)
theme_override_font_sizes/font_size = 18
text = "💎 0"

[node name="SyncUploadButton" type="Button" parent="MarginContainer/VBox/TopBar"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(80, 32)
text = "上传存档"

[node name="SyncDownloadButton" type="Button" parent="MarginContainer/VBox/TopBar"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(80, 32)
text = "下载存档"

[node name="BackButton" type="Button" parent="MarginContainer/VBox/TopBar"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(80, 32)
text = "返回"

[node name="LoginButton" type="Button" parent="MarginContainer/VBox/TopBar"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(100, 32)
text = "登录"

[node name="HSplit" type="HSplitContainer" parent="MarginContainer/VBox"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 200

[node name="LeftPanel" type="PanelContainer" parent="MarginContainer/VBox/HSplit"]
layout_mode = 2
custom_minimum_size = Vector2(200, 0)

[node name="CharacterList" type="ItemList" parent="MarginContainer/VBox/HSplit/LeftPanel"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(180, 0)
allow_reselect = true
theme_override_colors/font_selected_color = Color(1, 0.85, 0.2, 1)
theme_override_constants/icon_max_width = 32

[node name="RightPanel" type="PanelContainer" parent="MarginContainer/VBox/HSplit"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CharDetail" type="VBoxContainer" parent="MarginContainer/VBox/HSplit/RightPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="BottomBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
alignment = 1

[node name="StartButton" type="Button" parent="MarginContainer/VBox/BottomBar"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(240, 44)
theme_override_font_sizes/font_size = 16
text = "开始游戏"

[connection signal="item_selected" from="MarginContainer/VBox/HSplit/LeftPanel/CharacterList" to="." method="_on_character_list_item_selected"]
[connection signal="pressed" from="MarginContainer/VBox/BottomBar/StartButton" to="." method="_on_start_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/TopBar/SyncUploadButton" to="." method="_on_sync_upload_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/TopBar/SyncDownloadButton" to="." method="_on_sync_download_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/TopBar/LoginButton" to="." method="_on_login_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/TopBar/BackButton" to="." method="_on_back_button_pressed"]
